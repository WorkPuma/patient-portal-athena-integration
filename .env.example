# ─────────────────────────────────────────────────────────────
# Patient Portal — Environment Variables (STUBBED EXAMPLE)
#
# Copy this file to .env.local and fill in your real values.
# All integrations below are stubbed with placeholders.
# No real API keys, client IDs, endpoints, or patient data
# are included in this repository.
# ─────────────────────────────────────────────────────────────

# ── Next.js ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk Authentication ────────────────────────────────────
# Create a Clerk application at https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_CLERK_SECRET_KEY

# ── Athenahealth EHR API ─────────────────────────────────────
# https://developer.athenahealth.com
ATHENA_BASE_URL=https://api.athenahealth.com/v1/REPLACE_WITH_YOUR_PRACTICE_ID
ATHENA_PRACTICE_ID=REPLACE_WITH_YOUR_PRACTICE_ID
ATHENA_CLIENT_ID=REPLACE_WITH_YOUR_ATHENA_CLIENT_ID
ATHENA_CLIENT_SECRET=REPLACE_WITH_YOUR_ATHENA_CLIENT_SECRET

# ── Salesforce ──────────────────────────────────────────────
SALESFORCE_CLIENT_ID=REPLACE_WITH_YOUR_SF_CLIENT_ID
SALESFORCE_CLIENT_SECRET=REPLACE_WITH_YOUR_SF_CLIENT_SECRET
SALESFORCE_INSTANCE_URL=https://REPLACE_WITH_YOUR_INSTANCE.my.salesforce.com

# ── Retell AI ───────────────────────────────────────────────
# https://retell.ai
RETELL_API_KEY=REPLACE_WITH_YOUR_RETELL_API_KEY
RETELL_AGENT_ID=REPLACE_WITH_YOUR_RETELL_AGENT_ID

# ── Insurance Eligibility (Stedi) ──────────────────────────
# https://stedi.com
STEDI_API_KEY=REPLACE_WITH_YOUR_STEDI_API_KEY

# ── Upstash (Redis / QStash) ────────────────────────────────
# https://upstash.com — used for rate limiting and async queues
UPSTASH_REDIS_REST_URL=https://REPLACE_WITH_YOUR_UPSTASH_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_YOUR_UPSTASH_TOKEN
QSTASH_TOKEN=REPLACE_WITH_YOUR_QSTASH_TOKEN
QSTASH_CURRENT_SIGNING_KEY=REPLACE_WITH_YOUR_QSTASH_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=REPLACE_WITH_YOUR_QSTASH_SIGNING_KEY

# ── Google Places API ───────────────────────────────────────
# Used for address autocomplete during registration
GOOGLE_PLACES_API_KEY=REPLACE_WITH_YOUR_GOOGLE_PLACES_API_KEY

# ── Email (Resend) ───────────────────────────────────────────
# https://resend.com
RESEND_API_KEY=REPLACE_WITH_YOUR_RESEND_API_KEY

# ── Hint (Membership / Billing) ──────────────────────────────
HINT_API_URL=https://REPLACE_WITH_YOUR_HINT_API_URL
HINT_API_KEY=REPLACE_WITH_YOUR_HINT_API_KEY
